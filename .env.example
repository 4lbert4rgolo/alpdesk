APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- AlpDesk ----
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_DOMAINS=
TASKS_VISIBILITY_RESTRICTED=true
# Avisos por e-mail das tarefas. Com MAIL_MAILER=log, os e-mails vão para storage/logs/laravel.log
TASKS_EMAIL_NOTIFICATIONS=true
FORCE_HTTPS=false

# LGPD: aceite dos Termos de Uso e da Política de Privacidade (config/alpdesk.php)
# Troque TERMS_VERSION quando mudar os textos: todos aceitam de novo no próximo acesso.
TERMS_ACCEPTANCE_REQUIRED=true
TERMS_VERSION=2026-11-23

# Dados da empresa (Termos de Uso e Política de Privacidade): ficam só no .env, nunca no código
EMPRESA_NOME=
EMPRESA_CNPJ=
EMPRESA_ENDERECO=
EMPRESA_ENCARREGADO_NOME=
EMPRESA_ENCARREGADO_EMAIL=
EMPRESA_PRAZO_GUARDA_ANOS=5
EMPRESA_BACKUP_DIAS=30
