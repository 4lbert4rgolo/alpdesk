# =============================================================================
# AlpDesk - modelo de .env para PRODUÇÃO
# Copie para .env NO SERVIDOR, preencha os valores e rode: php artisan key:generate
# Nunca coloque este arquivo preenchido no Git nem dentro de um zip.
# =============================================================================

APP_NAME=AlpDesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://helpdesk.suaempresa.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

# Logs diários, guardados por 14 dias
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Banco de dados: use um usuário próprio, com senha forte (nunca o root)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alpdesk
DB_USERNAME=alpdesk
DB_PASSWORD=

# Sessão e cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mail real (confirmação de e-mail e "esqueci a senha" dependem disto)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="helpdesk@suaempresa.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AlpDesk ----
# Cadastro público: deixe false e crie os usuários em Administração > Usuários
REGISTRATION_ENABLED=false
# Se ligar o cadastro, limite aos domínios da empresa (separados por vírgula)
REGISTRATION_ALLOWED_DOMAINS=
# true: quem só abre tarefas (Solicitante) vê apenas as próprias
TASKS_VISIBILITY_RESTRICTED=true
# true quando o site é acessado por https (Nginx, Cloudflare Tunnel...)
FORCE_HTTPS=true
